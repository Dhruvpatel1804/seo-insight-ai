# =============================================================================
# SEO Insight AI — Environment Configuration
# =============================================================================
# Copy this file to `.env` and update values for your environment.
# Never commit `.env` to version control.
#
# Boolean values: true | false
# List values: comma-separated (e.g. http://localhost:3000,https://app.example.com)
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PROJECT_NAME=SEO Insight AI
PROJECT_VERSION=1.0.0
DEBUG=false


# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Interactive API documentation (disable in production if desired)
API_DOCS_ENABLED=true
API_SWAGGER_PATH=/swagger-docs/
API_REDOC_PATH=/custom-docs/

# CORS — use explicit origins in production (avoid *)
API_CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
LOG_HTTPX_LEVEL=WARNING


# -----------------------------------------------------------------------------
# OpenAI
# https://platform.openai.com/docs/api-reference
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2


# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
AUDIT_CACHE_TTL_SECONDS=86400


# -----------------------------------------------------------------------------
# Google PageSpeed Insights API
# https://developers.google.com/speed/docs/insights/v5/get-started
# -----------------------------------------------------------------------------
PAGESPEED_API_KEY=
PAGESPEED_API_URL=https://www.googleapis.com/pagespeedonline/v5/runPagespeed
PAGESPEED_TIMEOUT_SECONDS=120
PAGESPEED_CATEGORY=performance


# -----------------------------------------------------------------------------
# HTTP Client & Security Limits
# -----------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=SEO-Insight-AI/1.0
MAX_RESPONSE_BYTES=5000000
MAX_REDIRECTS=5
MAX_URL_LENGTH=2048


# -----------------------------------------------------------------------------
# Report Storage
# -----------------------------------------------------------------------------
REPORTS_DIR=reports
